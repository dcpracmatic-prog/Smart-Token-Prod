# Copia a friction.env y ajusta UNA línea.

# Opción A — Redis real (varios hosts)
# SMART_TOKEN_FRICTION_REDIS=redis://:cambia-esto@127.0.0.1:6379/0

# Opción B — broker incluido (sin Docker, mismo efecto de contador compartido)
SMART_TOKEN_FRICTION_BROKER=127.0.0.1:9379

# Opción C — solo disco compartido / NFS
# SMART_TOKEN_FRICTION_DIR=/var/lib/smart-token/friction
